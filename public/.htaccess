# =========================================================================
# Apache / LiteSpeed — для обычного хостинга (ISPmanager, cPanel и подобные)
# -------------------------------------------------------------------------
# Копируется в dist/ при сборке. На Vercel игнорируется, мешать не будет.
#
# Каждый блок обёрнут в <IfModule>: если на хостинге модуля нет, строка
# просто не применится, а не уронит весь сайт пятисоткой.
# =========================================================================

# ---- Кодировка ----------------------------------------------------------
# Часть хостингов по умолчанию отдаёт latin-1, и тогда весь русский текст
# приезжает крокозябрами. Сайт при этом выглядит сломанным целиком.
AddDefaultCharset utf-8
<IfModule mod_mime.c>
  AddCharset utf-8 .html .css .js .json .xml .svg .txt
</IfModule>

# ---- Страница 404 -------------------------------------------------------
# Astro кладёт её в корень как 404.html, а не папкой.
ErrorDocument 404 /404.html

# ---- Только https -------------------------------------------------------
<IfModule mod_rewrite.c>
  RewriteEngine On

  # HTTPS=on не работает за прокси-балансировщиком, поэтому проверяем и
  # заголовок, который такой балансировщик проставляет.
  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP:X-Forwarded-Proto} !=https
  RewriteRule ^(.*)$ https://%{HTTP_HOST}/$1 [R=301,L]
</IfModule>

# ---- Слэш на конце ------------------------------------------------------
# Astro собран с trailingSlash: 'always', и каждая страница лежит папкой
# с index.html. Штатный DirectorySlash сам добавит слэш к /uslugi —
# собственное правило переписывания здесь только создало бы петлю.
<IfModule mod_dir.c>
  DirectorySlash On
  DirectoryIndex index.html
</IfModule>

# ---- Кэш ----------------------------------------------------------------
<IfModule mod_headers.c>
  # Содержимое _astro/ имеет отпечаток в имени: меняется файл — меняется
  # имя. Такое можно кэшировать навсегда.
  <FilesMatch "\.(js|css)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>

  # Шрифты лежат под постоянными именами, поэтому год — но без immutable:
  # если файл когда-нибудь заменят, обновление сможет дойти до людей.
  <FilesMatch "\.woff2$">
    Header set Cache-Control "public, max-age=31536000"
  </FilesMatch>

  # HTML не кэшируем: иначе после выкладки люди ещё сутки видят старое.
  <FilesMatch "\.html$">
    Header set Cache-Control "public, max-age=0, must-revalidate"
  </FilesMatch>

  # ---- Заголовки безопасности — те же, что в vercel.json ----
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "SAMEORIGIN"
</IfModule>

# ---- Сжатие -------------------------------------------------------------
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml
  AddOutputFilterByType DEFLATE application/javascript application/json
  AddOutputFilterByType DEFLATE image/svg+xml
  # woff2 уже сжат, второй проход только тратит процессор.
</IfModule>

# ---- Не показывать содержимое папок -------------------------------------
<IfModule mod_autoindex.c>
  Options -Indexes
</IfModule>
