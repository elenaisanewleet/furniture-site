---
import { PARTS } from '~/data/parts';

/**
 * The signature block (brief §04).
 *
 * Instead of teaching furniture vocabulary, it shows that the vocabulary is
 * *our* job. Each card leads with the phrase a real person would use; the
 * term follows quietly underneath.
 *
 * Drawn diagrams rather than photographs on purpose: for recognising a part
 * a clean line drawing beats a photo, and it keeps us honest — we are not
 * passing off catalogue images as our own.
 */
const SHOWCASE = ['petlya', 'napravlyayushchaya', 'podyemnik', 'ruchka', 'ne-znayu'];
const parts = SHOWCASE.map((id) => PARTS.find((p) => p.id === id)!).filter(Boolean);
---

<section class="ni section--ink grain">
  <div class="container">
    <div class="ni__head">
      <p class="eyebrow ni__eyebrow">Главное</p>
      <h2 class="ni__title">Не знаете, как это&nbsp;называется?</h2>
      <p class="ni__lede">
        И не нужно. Искать название детали в интернете — не ваша работа.
        Сфотографируйте её, а разбираться будем мы.
      </p>
    </div>

    <ol class="ni__steps">
      <li><span>1</span> Сделайте фото</li>
      <li><span>2</span> Отправьте нам</li>
      <li><span>3</span> Мастер посмотрит, что можно сделать</li>
    </ol>

    <div
      class="ni__scroll scroll-x"
      tabindex="0"
      role="group"
      aria-label="Детали, которые чаще всего не могут назвать"
    >
      <ul class="ni__parts">
        {
          parts.map((p) => (
            <li class="ni__part">
              <a class="ni__card" href={`/opredelitel/#${p.id}`}>
                <span class="ni__draw" set:html={p.svg} />
                <span class="ni__said">{p.said}</span>
                <span class="ni__term">{p.term}</span>
              </a>
            </li>
          ))
        }
      </ul>
    </div>

    <div class="ni__cta">
      <a class="btn btn--on-ink btn--lg" href="/opredelitel/">
        Открыть определитель детали
      </a>
      <button class="ni__link" type="button" data-open-task data-cta="nameit" data-preset="part">
        Или сразу сфотографировать свою →
      </button>
    </div>
  </div>
</section>

<style>
  .ni { padding-block: var(--section-y); }

  .ni__head { max-width: 44rem; }

  .ni__eyebrow { color: color-mix(in srgb, var(--ink-invert) 60%, transparent); }
  .ni__eyebrow::before { background: var(--accent-on-ink); }

  .ni__title {
    font-size: var(--display-sm);
    line-height: var(--lh-display);
    letter-spacing: var(--tracking-display);
    margin-block-start: var(--sp-4);
    color: var(--ink-invert);
    text-wrap: balance;
  }

  .ni__lede {
    margin-block-start: var(--sp-4);
    font-size: var(--step-1);
    line-height: 1.5;
    color: color-mix(in srgb, var(--ink-invert) 72%, transparent);
    max-width: 44ch;
  }

  .ni__steps {
    display: grid;
    gap: var(--sp-3);
    list-style: none;
    margin: var(--sp-7) 0 var(--sp-6);
    padding: 0;
  }
  .ni__steps li {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    font-family: var(--font-display);
    font-size: var(--step-1);
    font-weight: 600;
    letter-spacing: var(--tracking-heading);
    color: var(--ink-invert);
  }
  .ni__steps span {
    display: grid;
    place-items: center;
    width: 1.9rem;
    height: 1.9rem;
    flex: none;
    border-radius: var(--r-sm);
    border: 1.5px solid var(--accent-on-ink);
    color: var(--accent-on-ink);
    font-size: 0.85rem;
    font-weight: 700;
  }

  .ni__scroll {
    margin-inline: calc(var(--gutter) * -1);
    padding-inline: var(--gutter);
    padding-block-end: var(--sp-3);
  }

  .ni__parts {
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: minmax(12rem, 1fr);
    gap: var(--sp-4);
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .ni__card {
    display: grid;
    gap: 0.25rem;
    align-content: start;
    height: 100%;
    padding: var(--sp-4);
    background: color-mix(in srgb, var(--ink-invert) 5%, transparent);
    border: 1px solid color-mix(in srgb, var(--ink-invert) 12%, transparent);
    border-radius: var(--r-lg);
    text-decoration: none;
    transition:
      background-color var(--dur-2) var(--ease),
      border-color var(--dur-2) var(--ease),
      transform var(--dur-2) var(--ease);
  }
  .ni__card:hover {
    background: color-mix(in srgb, var(--ink-invert) 9%, transparent);
    border-color: var(--accent-on-ink);
    transform: translateY(-3px);
  }

  .ni__draw {
    display: block;
    margin-block-end: var(--sp-3);
    color: color-mix(in srgb, var(--ink-invert) 86%, transparent);
  }
  .ni__draw :global(svg) { width: 100%; height: auto; }
  .ni__card:hover .ni__draw { color: var(--accent-on-ink); }

  .ni__said {
    font-family: var(--font-display);
    font-size: var(--step-0);
    font-weight: 600;
    line-height: 1.3;
    color: var(--ink-invert);
  }

  .ni__term {
    font-size: var(--step--2);
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: var(--accent-on-ink);
  }

  .ni__cta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--sp-4);
    margin-block-start: var(--sp-7);
  }

  .ni__link {
    font-size: var(--step--1);
    color: color-mix(in srgb, var(--ink-invert) 75%, transparent);
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }
  .ni__link:hover { color: var(--ink-invert); }

  @media (min-width: 46rem) {
    .ni__steps {
      grid-auto-flow: column;
      grid-auto-columns: 1fr;
      gap: var(--sp-5);
    }
    .ni__steps li { align-items: start; flex-direction: column; gap: 0.6rem; }
  }

  @media (min-width: 62rem) {
    .ni__parts { grid-auto-columns: minmax(0, 1fr); }
    .ni__scroll { overflow: visible; margin-inline: 0; padding-inline: 0; }
  }
</style>
