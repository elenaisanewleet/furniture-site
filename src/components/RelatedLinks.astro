---
interface Props {
  title?: string;
  items: { label: string; href: string; note?: string }[];
  columns?: 2 | 3;
}
const { title = 'Смотрите также', items, columns = 3 } = Astro.props;
---

{
  items.length > 0 && (
    <nav class="rl" aria-label={title}>
      <h2 class="rl__title">{title}</h2>
      <ul class:list={['rl__list', `rl__list--${columns}`]}>
        {items.map((i) => (
          <li>
            <a href={i.href}>
              <span class="rl__label">{i.label}</span>
              {i.note && <span class="rl__note">{i.note}</span>}
            </a>
          </li>
        ))}
      </ul>
    </nav>
  )
}

<style>
  .rl { margin-block-start: var(--sp-7); }

  .rl__title {
    font-size: var(--step--2);
    font-weight: 650;
    letter-spacing: var(--tracking-eyebrow);
    text-transform: uppercase;
    color: var(--ink-3);
    padding-block-end: var(--sp-3);
    border-block-end: 1px solid var(--line);
    margin-block-end: var(--sp-4);
  }

  .rl__list {
    display: grid;
    gap: 0.5rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .rl__list a {
    display: grid;
    gap: 0.1rem;
    height: 100%;
    padding: var(--sp-4);
    background: var(--paper-sunken);
    border-radius: var(--r-md);
    text-decoration: none;
    transition: background-color var(--dur-2) var(--ease);
  }
  .rl__list a:hover { background: var(--accent-soft); }

  .rl__label { font-weight: 600; font-size: var(--step-0); }
  .rl__note { font-size: var(--step--2); color: var(--ink-3); line-height: 1.4; }

  @media (min-width: 40rem) {
    .rl__list--2 { grid-template-columns: repeat(2, 1fr); }
    .rl__list--3 { grid-template-columns: repeat(2, 1fr); }
  }
  @media (min-width: 62rem) {
    .rl__list--3 { grid-template-columns: repeat(3, 1fr); }
  }
</style>
