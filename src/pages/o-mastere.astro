---
import Base from '~/layouts/Base.astro';
import Breadcrumbs from '~/components/Breadcrumbs.astro';
import Photo from '~/components/Photo.astro';
import Steps from '~/components/Steps.astro';
import ShowTask from '~/components/ShowTask.astro';

const trail = [
  { name: 'Главная', href: '/' },
  { name: 'Мастерская', href: '/o-mastere/' },
];

const SHOTS = [
  {
    name: 'workshop-room',
    alt: 'Общий вид мастерской: верстаки, торцовочная пила, стеллажи',
    ratio: '4/5',
  brief: 'Общий вид небольшой мастерской: самодельные верстаки вдоль стен, торцовочная пила на деревянном столе, полки с ящиками, бетонный пол, стены из сосновой вагонки. Тёплый свет лампы.',
  },
  {
    name: 'workshop-tools-wall',
    alt: 'Инструмент на стене мастерской',
    ratio: '4/5',
  brief: 'Стена мастерской с инструментом: уровень, дисковые пилы на гвоздях, рулетка. Сосновая вагонка, тёплый свет.',
  },
  {
    name: 'workshop-bench',
    alt: 'Верстак с сортированным крепежом',
    ratio: '4/3',
  brief: 'Длинный самодельный верстак: толстая доска на металлическом каркасе, на ней и под ней — стеклянные банки, пластиковые контейнеры и жестянки с крепежом.',
  },
  {
    name: 'workshop-corner',
    alt: 'Рабочий угол мастерской',
    ratio: '4/3',
  brief: 'Рабочий угол: верстак с металлической столешницей, тиски, коробка крепежа, старый кирпич и вагонка на стенах.',
  },
];

/**
 * Оборудование. Это подтверждено фотографиями, которые прислал мастер, —
 * поэтому здесь можно называть станки. Чего мы по-прежнему не утверждаем:
 * какие именно операции он берётся выполнять на заказ (см. /review/).
 */
const EQUIPMENT = [
  {
    name: 'eq-drill-press',
    alt: 'Сверлильный станок',
    title: 'Сверлильный станок',
    text: 'Ровное отверстие под углом 90° — то, чего не получить дрелью в руках.',
  brief: 'Настольный сверлильный станок, старый, крашеный, на деревянной подставке у стены из вагонки.',
  },
  {
    name: 'eq-mitre-saw',
    alt: 'Торцовочная пила',
    title: 'Торцовочная пила',
    text: 'Рез в размер и под углом.',
  brief: 'Торцовочная пила на самодельном деревянном столе, опилки вокруг.',
  },
  {
    name: 'eq-planer',
    alt: 'Универсальный деревообрабатывающий станок',
    title: 'Деревообрабатывающий станок',
    text: 'Строгание и раскрой массива.',
  brief: 'Деревообрабатывающий станок на колёсиках под верстаком, синий корпус, красная кнопка аварийного выключения.',
  },
  {
    name: 'eq-grinder',
    alt: 'Точильный станок',
    title: 'Точило',
    text: 'Доводка и заточка металлических деталей.',
  brief: 'Точило с двумя абразивными кругами и защитными кожухами на металлической станине.',
  },
  {
    name: 'eq-press',
    alt: 'Ручной пресс',
    title: 'Ручной пресс',
    text: 'Работа с металлом, а не только с плитой.',
  brief: 'Чугунный ручной винтовой пресс на верстаке — работа с металлом, а не только с плитой.',
  },
  {
    name: 'eq-circular-saw',
    alt: 'Циркулярная пила',
    title: 'Пила и ручной инструмент',
    text: 'Всё остальное, что нужно по месту.',
  brief: 'Дисковая пила и другой ручной инструмент, сложенные у стены мастерской.',
  },
];
---

<Base
  title="Мастерская"
  description="Небольшая мебельная мастерская: кто смотрит заявки, кто делает работу и почему здесь берутся за одну деталь, а не только за мебель целиком."
  canonical="/o-mastere/"
  breadcrumb={trail}
>
  <Breadcrumbs trail={trail} />

  <header class="container om__head">
    <p class="eyebrow">О нас</p>
    <h1>Кто будет делать вашу мебель</h1>
    <p class="lede">
      Небольшая мастерская. Между вами и тем, кто держит в руках инструмент,
      нет отдела продаж.
    </p>
  </header>

  <section class="container om__intro">
    <div class="om__text">
      <p>
        Здесь не любят слово «заявка». То, с чем к нам приходят, — это
        обычно не заявка, а история: шкаф достался от прежних хозяев, дверца
        давно висит криво, а вчера отвалилась совсем. Или наоборот: в
        комнате есть неудобный угол, и уже год непонятно, что с ним делать.
      </p>
      <p>
        Такие истории плохо укладываются в форму с полями «тип мебели» и
        «бюджет». Поэтому мы просим не заполнять анкету, а просто показать —
        фотографией, парой слов, голосом. Дальше разберёмся.
      </p>
      <p>
        Сначала заявку смотрит человек: читает описание, проверяет
        фотографии, при необходимости задаёт один-два уточняющих вопроса
        обычными словами. Мастер получает уже понятную задачу и отвечает по
        существу, а не тратит время на выяснение, о чём вообще речь.
      </p>
    </div>

    <aside class="om__portrait">
      <Photo
        name="master-hands"
        alt="Руки мастера разбирают коробку с мебельной фурнитурой"
        ratio="4/5"
        sizes="(min-width: 62rem) 34vw, 100vw"
      brief="Руки мастера держат мебельную деталь над открытой картонной коробкой с такими же. Лицо не в кадре, видно только руки и рукава. Тёплый свет, верстак."
          />
      <p class="om__portrait-note">
        Портрет мастера и рассказ о нём появятся здесь, когда он сам решит,
        что публиковать. Придумывать за него имя, стаж и биографию мы
        не стали.
      </p>
    </aside>
  </section>

  <section class="section--sm">
    <div class="container">
      <div class="section-head">
        <p class="eyebrow">Мастерская</p>
        <h2>Как это выглядит</h2>
      </div>
      <div class="om__gallery">
        {
          SHOTS.map((s) => (
            <Photo
              name={s.name}
              alt={s.alt}
              ratio={s.ratio}
              sizes="(min-width: 62rem) 45vw, 100vw"
            />
          ))
        }
      </div>
    </div>
  </section>

  <section class="section--sm">
    <div class="container">
      <div class="section-head">
        <p class="eyebrow">Оборудование</p>
        <h2>Что здесь есть</h2>
        <p class="lede">
          Это не сборочный цех и не мебельный салон — рабочая мастерская,
          в которой есть и деревообработка, и металл.
        </p>
      </div>

      <ul class="om__equipment">
        {
          EQUIPMENT.map((e) => (
            <li class="reveal-up">
              <Photo
                name={e.name}
                alt={e.alt}
                ratio="4/5"
                sizes="(min-width: 62rem) 30vw, 45vw"
              />
              <h3>{e.title}</h3>
              <p>{e.text}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="section--sm section--sunken">
    <div class="container">
      <div class="section-head">
        <p class="eyebrow">Принципы</p>
        <h2>Как мы предпочитаем работать</h2>
      </div>
      <ul class="om__principles">
        <li>
          <h3>Сначала посмотреть, потом называть цену</h3>
          <p>
            Сумма, названная по телефону наугад, всё равно изменится. Лучше
            потратить пять минут на фотографии.
          </p>
        </li>
        <li>
          <h3>Говорить, когда делать не стоит</h3>
          <p>
            Иногда ремонт дороже нового изделия, а иногда новая мебель не
            решает проблему. Об этом честнее сказать сразу.
          </p>
        </li>
        <li>
          <h3>Маленькая задача — тоже задача</h3>
          <p>
            Одна петля, одна полка, одна дверца. За такое часто не берутся,
            а человеку деваться некуда.
          </p>
        </li>
        <li>
          <h3>Объяснять без терминов</h3>
          <p>
            Если для понимания ответа нужно гуглить слова — ответ плохой.
          </p>
        </li>
      </ul>
    </div>
  </section>

  <Steps
    title="Что происходит после того, как вы показали задачу"
    eyebrow="Процесс"
  />

  <ShowTask tone="ink" />
</Base>

<style>
  .om__head {
    padding-block: var(--sp-6) var(--sp-7);
    max-width: 44rem;
    display: grid;
    gap: var(--sp-4);
  }
  .om__head h1 { font-size: var(--display-sm); line-height: var(--lh-display); }

  .om__intro {
    display: grid;
    gap: var(--sp-7);
    align-items: start;
  }

  .om__text { display: grid; gap: var(--sp-4); }
  .om__text p { color: var(--ink-2); line-height: 1.7; max-width: 60ch; }

  .om__portrait { display: grid; gap: var(--sp-4); }
  .om__portrait-note {
    padding: var(--sp-4);
    background: var(--paper-sunken);
    border-inline-start: 2px solid var(--accent);
    border-radius: var(--r-sm);
    font-size: var(--step--1);
    color: var(--ink-2);
    line-height: 1.55;
  }

  .om__gallery { display: grid; gap: var(--sp-4); }

  .om__equipment {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--sp-5) var(--sp-4);
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .om__equipment h3 {
    margin-block: var(--sp-3) 0.25rem;
    font-size: var(--step-0);
  }
  .om__equipment p {
    font-size: var(--step--1);
    color: var(--ink-2);
    line-height: 1.5;
  }

  .om__principles {
    display: grid;
    gap: 0;
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .om__principles li {
    padding-block: var(--sp-5);
    border-block-start: 1px solid var(--line);
  }
  .om__principles h3 { font-size: var(--step-1); margin-block-end: 0.35rem; }
  .om__principles p { color: var(--ink-2); font-size: var(--step--1); line-height: 1.55; max-width: 48ch; }

  @media (min-width: 40rem) {
    .om__gallery { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
  @media (min-width: 62rem) {
    .om__equipment { grid-template-columns: repeat(3, minmax(0, 1fr)); }
  }
  @media (min-width: 62rem) {
    .om__intro { grid-template-columns: minmax(0, 1fr) minmax(0, 22rem); gap: var(--sp-8); }
    .om__principles { grid-template-columns: repeat(2, minmax(0, 1fr)); column-gap: var(--sp-7); }
    .om__principles li:nth-child(2) { border-block-start: 1px solid var(--line); }
  }
</style>
