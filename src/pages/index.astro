---
import { getCollection } from 'astro:content';
import Base from '~/layouts/Base.astro';
import Photo from '~/components/Photo.astro';
import PhotoIntake from '~/components/PhotoIntake.astro';
import ProblemGrid from '~/components/ProblemGrid.astro';
import NameItBlock from '~/components/NameItBlock.astro';
import ServiceCard from '~/components/ServiceCard.astro';
import ProjectCard from '~/components/ProjectCard.astro';
import Steps from '~/components/Steps.astro';
import FaqList from '~/components/FaqList.astro';
import ShowTask from '~/components/ShowTask.astro';
import { primaryContact } from '~/data/site';
import { isPublic } from '~/lib/facts';
import { faqPage } from '~/lib/schema';

const GROUP_ORDER = ['mebel', 'remont', 'furnitura', 'detali'];
const services = (await getCollection('services'))
  .filter((s) => isPublic(s.data.status) && !s.data.parent)
  .sort(
    (a, b) =>
      GROUP_ORDER.indexOf(a.data.group) - GROUP_ORDER.indexOf(b.data.group) ||
      a.data.order - b.data.order
  );

const projects = (await getCollection('projects'))
  .sort((a, b) => a.data.order - b.data.order)
  .slice(0, 3);

const faqAll = (await getCollection('faq'))
  .filter((f) => isPublic(f.data.status))
  .sort((a, b) => a.data.order - b.data.order)
  .slice(0, 6);
const faqItems = faqAll.map((f) => ({ q: f.data.q, a: f.data.a, status: f.data.status }));

/** The phrases people actually use. Runs as a marquee under the hero. */
const SAID = [
  'дверца перекосилась',
  'вот эта штука отвалилась',
  'рельса от ящика',
  'не знаю, как называется',
  'нужна такая же деталь',
  'ящик выпадает',
  'шкаф в нишу, но там труба',
  'хочу как на картинке',
  'ручка вырвалась с куском',
  'полка провисла',
  'петлю не могу найти',
  'кухня не встаёт по размеру',
];

const REASONS = [
  {
    n: '01',
    title: 'Задачу можно показать фотографией',
    text: 'Не нужно знать, как называется деталь, механизм или тип петли. Снимите — дальше наша забота.',
  },
  {
    n: '02',
    title: 'Беремся за отдельную деталь',
    text: 'Можно прийти с одной дверцей, одной полкой или одной сломанной направляющей. Заказывать мебель целиком не обязательно.',
  },
  {
    n: '03',
    title: 'Ремонт вместо покупки',
    text: 'Иногда корпус целый, а изношена только фурнитура. Тогда менять всю мебель незачем — и мы об этом скажем.',
  },
  {
    n: '04',
    title: 'Разговор без терминов',
    text: 'Объясняем на нормальном языке. Если что-то непонятно по фото — спросим, а не будем гадать.',
  },
  {
    n: '05',
    title: 'Небольшая мастерская напрямую',
    text: 'Задача не идёт через менеджера, дизайнера и отдел продаж. Вы разговариваете с теми, кто её и делает.',
  },
  {
    n: '06',
    title: 'Нестандартное — это нормально',
    text: 'Кривая стена, труба в углу, скошенный потолок, размер, которого не бывает в магазине. Такие задачи интереснее типовых.',
  },
];
---

<Base
  title="Мебель на заказ, ремонт и фурнитура в Ульяновске"
  description="Мебель на заказ, ремонт, переделка и нестандартные детали в Ульяновске. Не знаете, как называется деталь? Просто сфотографируйте — посмотрим, что можно сделать."
  canonical="/"
  topTheme="ink"
  schema={[faqPage(faqItems.map(({ q, a }) => ({ q, a })))].filter(Boolean)}
>
  <!-- ============================================================ 01 HERO -->
  <section class="hero section--ink grain">
    <div class="container hero__inner">
      <div class="hero__copy">
        <p class="hero__tag tag">Мастерская · Ульяновская область</p>

        <h1 class="hero__title">
          Покажите, что нужно&nbsp;сделать.
          <span>С остальным разберёмся.</span>
        </h1>

        <p class="hero__sub">
          Мебель на заказ, ремонт, переделка и нестандартные детали.
          Не нужно знать названия деталей, тип механизма и точные размеры —
          достаточно фотографии.
        </p>

        <div class="hero__actions">
          <button
            class="btn btn--accent btn--lg btn--magnet"
            type="button"
            data-open-task
            data-cta="hero"
            data-magnet
          >
            Показать задачу
          </button>
          <a class="btn btn--on-ink-ghost btn--lg" href="/opredelitel/">
            Определитель детали
          </a>
        </div>

        {
          primaryContact && (
            <p class="hero__phone">
              Или позвоните:{' '}
              <a href={`tel:${primaryContact.tel}`} data-track="phone_click" data-track-where="hero">
                {primaryContact.phone}
              </a>
            </p>
          )
        }
      </div>

      <div class="hero__media">
        <Photo
          name="hero-workshop"
          alt="Ручные пилы и струбцины на стене мастерской"
          ratio="4/5"
          priority
          parallax
          rounded={false}
          sizes="(min-width: 68rem) 44vw, 100vw"
        brief="Ручные пилы, лучковая пила и струбцины висят рядком на стене из сосновой вагонки. Рядом — рабочая куртка на крючке. Тёплый свет лампы, вертикальный кадр. Реальная мастерская при частном доме, не цех."
          />
        <div class="hero__frame" aria-hidden="true"></div>
      </div>
    </div>

    <!-- The words people actually use, on repeat. -->
    <div class="marquee hero__marquee" aria-hidden="true">
      <div class="marquee__track">
        {
          [0, 1].map(() => (
            <div class="hero__said-group">
              {SAID.map((s) => (
                <span class="hero__said">
                  «{s}»<i>·</i>
                </span>
              ))}
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- ================================================== 02 QUICK INTAKE -->
  <PhotoIntake />

  <!-- ============================================================ MODEL B -->
  <ProblemGrid />

  <!-- ======================================================= 03 SERVICES -->
  {
    services.length > 0 && (
      <section class="section services">
        <div class="container">
          <div class="section-head">
            <p class="eyebrow">Направления</p>
            <h2>С чем можно обратиться</h2>
            <p class="lede">
              Если вашей задачи здесь нет — это не значит, что мы её не возьмём.
              Проще показать и спросить.
            </p>
          </div>

          <div class="grid grid--2 stagger">
            {services.map((s, i) => (
              <div class="reveal-up" style={`--i:${i}`}>
                <ServiceCard
                  href={`/${s.id}/`}
                  title={s.data.title}
                  text={s.data.short}
                  image={s.data.hero}
                  size="lg"
                />
              </div>
            ))}
          </div>

          <p class="services__all">
            <a class="link" href="/uslugi/">Все направления и подразделы →</a>
          </p>
        </div>
      </section>
    )
  }

  <!-- ========================================================= 04 NAME IT -->
  <NameItBlock />

  <!-- =================================================== ЖЕЛЕЗО / ПРУФ -->
  <section class="section stock">
    <div class="container">
      <div class="stock__head">
        <div>
          <p class="eyebrow">Почему это вообще работает</p>
          <h2>Половина задач решается тем, что нужная железка уже лежит в ящике</h2>
        </div>
        <p class="stock__text">
          Мебель редко ломается целиком. Обычно изнашивается или теряется одна
          мелочь — петля, направляющая, эксцентрик, полкодержатель. Их
          неудобно искать поштучно и почти невозможно описать словами
          по телефону. Поэтому мы просим фотографию, а не название.
        </p>
      </div>

      <div class="stock__grid">
        <div class="stock__a reveal-wipe">
          <Photo
            name="workshop-fasteners-shelf"
            alt="Полка с банками и коробками сортированного крепежа"
            ratio="4/3"
            caption="крепёж разобран по банкам"
            sizes="(min-width: 62rem) 46vw, 100vw"
          brief="Полка с сортированным крепежом крупно: стеклянные банки, обрезанные пластиковые вёдра, контейнеры и коробки с саморезами, болтами, уголками. Главный кадр сайта — доказательство, что нужная железка найдётся."
          />
        </div>
        <div class="stock__b reveal-wipe">
          <Photo
            name="hardware-tray"
            alt="Тиски и лоток с разнообразным крепежом"
            ratio="4/5"
            caption="то, что обычно называют «вот эта штука»"
            sizes="(min-width: 62rem) 28vw, 50vw"
          brief="Зелёный пластиковый лоток с перемешанным крепежом — саморезы, уголки, пластины — стоит на верстаке рядом со слесарными тисками, крашенными синим."
          />
        </div>
        <div class="stock__c reveal-wipe">
          <Photo
            name="workshop-storage"
            alt="Стеллаж мастерской с разобранными по коробкам деталями"
            ratio="4/5"
            caption="мастерская, не склад"
            sizes="(min-width: 62rem) 24vw, 50vw"
          brief="Стеллаж от пола до потолка: картонные коробки с рукописными номерами, мешки, пластиковые ящики, банки. Плотно, но по местам."
          />
        </div>
      </div>
    </div>
  </section>

  <!-- ======================================================= МАСТЕРСКАЯ -->
  <section class="section section--sunken shop">
    <div class="container">
      <div class="section-head section-head--row">
        <div>
          <p class="eyebrow">Мастерская</p>
          <h2>Где всё это происходит</h2>
        </div>
        <a class="link" href="/o-mastere/">Заглянуть внутрь →</a>
      </div>

      <div class="shop__grid">
        <div class="shop__1 reveal-up">
          <Photo
            name="workshop-room"
            alt="Общий вид мастерской: верстаки, торцовочная пила, стеллажи"
            ratio="4/5"
            caption="общий вид"
            sizes="(min-width: 62rem) 32vw, 50vw"
          brief="Общий вид небольшой мастерской: самодельные верстаки вдоль стен, торцовочная пила на деревянном столе, полки с ящиками, бетонный пол, стены из сосновой вагонки. Тёплый свет лампы."
          />
        </div>
        <div class="shop__2 reveal-up" style="--i:1">
          <Photo
            name="eq-drill-press"
            alt="Сверлильный станок в мастерской"
            ratio="4/5"
            caption="сверлильный станок"
            sizes="(min-width: 62rem) 32vw, 50vw"
          brief="Настольный сверлильный станок, старый, крашеный, на деревянной подставке у стены из вагонки."
          />
        </div>
        <div class="shop__3 reveal-up" style="--i:2">
          <Photo
            name="workshop-bench"
            alt="Верстак с сортированным крепежом"
            ratio="4/3"
            caption="верстак"
            sizes="(min-width: 62rem) 32vw, 100vw"
          brief="Длинный самодельный верстак: толстая доска на металлическом каркасе, на ней и под ней — стеклянные банки, пластиковые контейнеры и жестянки с крепежом."
          />
        </div>
      </div>

      <p class="shop__note">
        Фотографии настоящие. Это не студийная съёмка и не шоурум —
        обычная рабочая мастерская, в которой есть и дерево, и металл.
      </p>
    </div>
  </section>

  <!-- ======================================================== 07 PROCESS -->
  <Steps />

  <!-- ========================================================= 08 MASTER -->
  <section class="section master section--ink grain">
    <div class="container master__inner">
      <div class="master__media">
        <Photo
          name="master-hands"
          alt="Руки мастера разбирают коробку с мебельной фурнитурой"
          ratio="4/5"
          rounded={false}
          sizes="(min-width: 62rem) 38vw, 100vw"
        brief="Руки мастера держат мебельную деталь над открытой картонной коробкой с такими же. Лицо не в кадре, видно только руки и рукава. Тёплый свет, верстак."
          />
      </div>

      <div class="master__copy">
        <p class="eyebrow">Мастерская</p>
        <h2>Кто будет делать вашу мебель</h2>
        <p class="master__lede">
          Небольшая мастерская, а не производство с отделом продаж. Тот, кто
          принимает задачу, и тот, кто её делает, — знают друг о друге всё.
        </p>
        <p>
          Первым заявку смотрит человек, а не робот: если по фотографии
          непонятно, что случилось, вам зададут один-два вопроса обычными
          словами. Дальше задача уходит мастеру уже в понятном виде.
        </p>
        <p class="master__slot">
          Портрет мастера и рассказ о нём появятся здесь, когда он сам решит,
          что публиковать. Придумывать за него мы не стали.
        </p>
        <a class="btn btn--on-ink" href="/o-mastere/">Заглянуть в мастерскую</a>
      </div>
    </div>
  </section>

  <!-- ============================================================ 09 WHY -->
  <section class="section">
    <div class="container">
      <div class="section-head">
        <p class="eyebrow">Почему сюда</p>
        <h2>Зачем к нам обращаются</h2>
      </div>

      <ul class="reasons stagger">
        {
          REASONS.map((r, i) => (
            <li class="reasons__item reveal-up" style={`--i:${i}`}>
              <span class="idx">{r.n}</span>
              <h3>{r.title}</h3>
              <p>{r.text}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- ============================================================ 10 FAQ -->
  {
    faqItems.length > 0 && (
      <FaqList
        items={faqItems}
        title="Что обычно спрашивают"
        lede="Короткие ответы на вопросы, которые задают чаще всего."
      />
    )
  }

  <ShowTask
    tone="ink"
    title="Покажите свою задачу"
    text="Одна фотография — уже достаточно, чтобы начать разговор. Всё остальное уточним сами."
    shots={[
      'общий вид мебели или места',
      'крупно — то, что сломалось или не подходит',
      'пример, который нравится, если он есть',
    ]}
  />
</Base>

<style>
  /* ===================================================== HERO =========== */
  .hero {
    position: relative;
    /* Header height is added back here — see body[data-top='ink'] in base.css */
    padding-block-start: calc(var(--header-h) + var(--sp-6));
    overflow: hidden;
  }

  .hero__inner {
    display: grid;
    gap: var(--sp-6);
    align-items: center;
    padding-block-end: var(--sp-8);
  }

  .hero__tag { margin-block-end: var(--sp-5); }

  .hero__title {
    font-size: var(--display);
    line-height: var(--lh-display);
    letter-spacing: var(--tracking-display);
    font-weight: 650;
    color: var(--ink-invert);
  }
  .hero__title span {
    display: block;
    color: color-mix(in srgb, var(--ink-invert) 46%, transparent);
  }

  .hero__sub {
    margin-block-start: var(--sp-5);
    font-size: var(--step-1);
    line-height: 1.5;
    color: color-mix(in srgb, var(--ink-invert) 74%, transparent);
    max-width: 44ch;
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.7rem;
    margin-block-start: var(--sp-6);
  }
  .hero__actions .btn { flex: 1 1 14rem; }

  .hero__phone {
    margin-block-start: var(--sp-5);
    font-size: var(--step--1);
    color: color-mix(in srgb, var(--ink-invert) 60%, transparent);
  }
  .hero__phone a {
    font-weight: 650;
    color: var(--ink-invert);
    white-space: nowrap;
  }

  .hero__media { position: relative; }
  /* Смещённый контур здесь один: тень листа и рамка — это одно и то же,
     а две подложки друг под другом читаются как брак печати.

     На узком экране фотография занимает всю ширину колонки, и смещённая
     рамка вылезает за край страницы — появляется горизонтальная прокрутка
     на всём сайте. Поэтому она включается только там, где есть запас. */
  .hero__frame { display: none; }

  @media (min-width: 46rem) {
    .hero__frame {
      display: block;
      position: absolute;
      inset: 0;
      translate: 0.85rem 0.85rem;
      border: 1px solid color-mix(in srgb, var(--accent-on-ink) 60%, transparent);
      z-index: -1;
    }
  }

  /* ---- Marquee ---- */
  .hero__marquee {
    border-block-start: 1px solid color-mix(in srgb, var(--ink-invert) 14%, transparent);
    padding-block: var(--sp-4);
  }
  .hero__said-group { display: flex; }
  .hero__said {
    display: inline-flex;
    align-items: center;
    gap: 1.4rem;
    padding-inline-end: 1.4rem;
    white-space: nowrap;
    font-size: var(--step-1);
    color: color-mix(in srgb, var(--ink-invert) 44%, transparent);
  }
  .hero__said i { color: var(--accent); font-style: normal; }

  /* ================================================== SERVICES ========== */
  .services__all {
    margin-block-start: var(--sp-5);
    font-size: var(--step--1);
  }

  .section-head--row {
    display: flex;
    flex-wrap: wrap;
    align-items: end;
    justify-content: space-between;
    gap: var(--sp-4);
    max-width: none;
  }

  /* ===================================================== STOCK ========== */
  .stock__head {
    display: grid;
    gap: var(--sp-5);
    margin-block-end: var(--sp-7);
  }
  .stock__head h2 {
    font-size: var(--step-4);
    max-width: 18ch;
    margin-block-start: var(--sp-4);
  }
  .stock__text {
    color: var(--ink-2);
    line-height: 1.65;
    max-width: 52ch;
  }

  .stock__grid {
    display: grid;
    gap: var(--sp-4);
  }

  /* ===================================================== SHOP =========== */
  .shop__grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--sp-4);
  }
  .shop__3 { grid-column: span 2; }

  .shop__note {
    margin-block-start: var(--sp-5);
    font-size: var(--step--1);
    color: var(--ink-3);
    max-width: 54ch;
  }

  /* ===================================================== MASTER ========= */
  .master__inner {
    display: grid;
    gap: var(--sp-6);
    align-items: center;
  }
  .master__media :global(.photo) { border-radius: var(--r-lg); }

  .master__copy { display: grid; gap: var(--sp-4); justify-items: start; }
  .master__copy h2 { font-size: var(--step-4); color: var(--ink-invert); }
  .master__copy p {
    color: color-mix(in srgb, var(--ink-invert) 72%, transparent);
    max-width: 48ch;
    line-height: 1.65;
  }
  .master__lede {
    font-size: var(--step-1);
    color: var(--ink-invert) !important;
  }
  .master__slot {
    padding: var(--sp-4);
    background: color-mix(in srgb, var(--ink-invert) 6%, transparent);
    border-inline-start: 2px solid var(--accent);
    border-radius: var(--r-sm);
    font-size: var(--step--1);
  }

  /* ==================================================== REASONS ========= */
  .reasons {
    display: grid;
    gap: 0;
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .reasons__item {
    padding-block: var(--sp-5);
    border-block-start: 1px solid var(--line);
  }
  .reasons__item h3 {
    font-size: var(--step-1);
    margin-block: 0.5rem 0.4rem;
  }
  .reasons__item p {
    color: var(--ink-2);
    font-size: var(--step--1);
    line-height: 1.55;
    max-width: 46ch;
  }

  /* ================================================ BREAKPOINTS ========= */
  @media (min-width: 46rem) {
    .reasons {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      column-gap: var(--sp-7);
    }
    .stock__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    .stock__a { grid-column: span 2; }
  }

  @media (min-width: 62rem) {
    .shop__grid { grid-template-columns: repeat(3, minmax(0, 1fr)); }
    .shop__3 { grid-column: auto; align-self: center; }
  }

  @media (min-width: 62rem) {
    .master__inner {
      grid-template-columns: minmax(0, 0.8fr) minmax(0, 1fr);
      gap: var(--sp-8);
    }
    .stock__head {
      grid-template-columns: minmax(0, 1.1fr) minmax(0, 1fr);
      align-items: end;
      gap: var(--sp-8);
    }
    .stock__grid {
      grid-template-columns: repeat(12, 1fr);
      gap: var(--sp-5);
    }
    .stock__a { grid-column: 1 / 8; }
