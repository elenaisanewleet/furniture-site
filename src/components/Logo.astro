---
import { site } from '~/data/site';

interface Props {
  /** Renders as a link everywhere except the home page header. */
  href?: string | null;
  compact?: boolean;
}
const { href = '/', compact = false } = Astro.props;
const Tag = href ? 'a' : 'span';
---

<!--
  Mark: a cabinet face seen straight on — carcass line, door, and the hinge
  pin in accent. It quietly states the whole positioning: the thing most
  people cannot name is the thing we start from.
-->
<Tag
  class:list={['logo', compact && 'logo--compact']}
  {...href ? { href } : {}}
  aria-label={`${site.brand.name} — на главную`}
>
  <svg class="logo__mark" viewBox="0 0 32 32" aria-hidden="true" focusable="false">
    <rect x="2.6" y="2.6" width="26.8" height="26.8" rx="3.2" fill="none" stroke="currentColor" stroke-width="2.2" />
    <path d="M11.6 2.6 V29.4" stroke="currentColor" stroke-width="2.2" />
    <circle cx="11.6" cy="16" r="3.3" class="logo__pin" />
  </svg>
  <span class="logo__text">
    <span class="logo__name">{site.brand.name}</span>
    {!compact && <span class="logo__tag">{site.brand.tagline}</span>}
  </span>
</Tag>

<style>
  .logo {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    color: inherit;
    text-decoration: none;
    line-height: 1.05;
  }

  .logo__mark {
    width: 1.85rem;
    height: 1.85rem;
    flex: none;
  }

  .logo__pin {
    fill: var(--accent);
  }

  .logo__text {
    display: grid;
    gap: 0.16rem;
  }

  .logo__name {
    font-family: var(--font-display);
    font-size: 1.06rem;
    font-weight: 700;
    letter-spacing: -0.025em;
  }

  :global(body[data-top='ink'] [data-header]:not(.is-stuck)) .logo__tag {
    color: color-mix(in srgb, var(--ink-invert) 74%, transparent);
  }

  .logo__tag {
    font-size: 0.61rem;
    font-weight: 500;
    letter-spacing: 0.055em;
    text-transform: lowercase;
    color: var(--ink-3);
    white-space: nowrap;
  }

  @media (max-width: 26rem) {
    .logo__tag { display: none; }
  }
</style>
