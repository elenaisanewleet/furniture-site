# Домен для canonical, sitemap и robots.txt
SITE_URL=https://example.ru

# Адрес обработчика заявок. Пусто = форма работает в демо-режиме.
PUBLIC_LEAD_ENDPOINT=

# Яндекс.Метрика. Пусто = счётчик не подключается.
PUBLIC_METRIKA_ID=

# Имя Telegram-бота без @. Задано — на сайте появляется передача заявки
# в переписку и кнопка «Продолжить в Telegram».
PUBLIC_TG_BOT=

# Режим проверки: показывает неподтверждённые утверждения.
# PUBLIC_SHOW_UNCONFIRMED=true

# --- сервер приёма заявок (server/index.mjs) ---
PORT=8787
DATA_DIR=./data
ALLOW_ORIGIN=https://example.ru
REDIRECT_URL=https://example.ru/spasibo/
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
