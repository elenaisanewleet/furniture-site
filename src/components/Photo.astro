---
import { resolve, register, ratioBox } from '~/lib/photo';
import lqip from '~/data/lqip.json';
import Drawing from './Drawing.astro';

interface Props {
  name: string;
  alt: string;
  ratio?: string;
  brief?: string;
  where?: string;
  /** Above-the-fold images opt out of lazy loading. */
  priority?: boolean;
  sizes?: string;
  class?: string;
  /** Rounded corners are the caller's choice, not baked in. */
  rounded?: boolean;
  /** Slow drift on scroll. Only for large decorative images. */
  parallax?: boolean;
  /** Shown under the image in mono — editorial caption. */
  caption?: string;
}

const {
  name,
  alt,
  ratio = '3/2',
  brief,
  where,
  priority = false,
  sizes = '(min-width: 68rem) 50vw, 100vw',
  class: className = '',
  rounded = true,
  parallax = false,
  caption,
} = Astro.props;

register({ name, alt, ratio, brief, where: where ?? Astro.url.pathname });

const src = resolve(name);
const { w, h } = ratioBox(ratio);
const blur = (lqip as Record<string, string>)[name];
---

<figure
  class:list={[
    'photo',
    rounded && 'photo--rounded',
    !src && 'photo--empty',
    parallax && 'photo--parallax',
    className,
  ]}
  style={`--ratio:${ratio};${blur ? ` --lqip:url("${blur}");` : ''}`}
  data-slot={name}
  data-parallax={parallax ? '' : undefined}
>
  {
    src ? (
      <img
        src={src}
        alt={alt}
        width={w}
        height={h}
        sizes={sizes}
        loading={priority ? 'eager' : 'lazy'}
        decoding={priority ? 'sync' : 'async'}
        fetchpriority={priority ? 'high' : 'auto'}
        onload="this.closest('.photo')?.setAttribute('data-loaded','')"
      />
    ) : (
      <Drawing slot={name} alt={alt} caption={caption} />
    )
  }
  {src && caption && <figcaption class="photo__caption">{caption}</figcaption>}
</figure>

<style>
  .photo {
    position: relative;
    aspect-ratio: var(--ratio);
    overflow: hidden;
    background: var(--paper-sunken);
    isolation: isolate;
    container-type: inline-size;
  }

  /* Blur-up: the 24px preview holds the frame until the real file decodes. */
  .photo:has(img) {
    background-image: var(--lqip, none);
    background-size: cover;
    background-position: center;
  }

  .photo--rounded {
    border-radius: var(--r-lg);
  }

  .photo :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0;
    transition: opacity var(--dur-3) var(--ease);
  }
  .photo[data-loaded] :global(img) { opacity: 1; }
  /* If the load event fired before hydration, don't leave it blank. */
  :global(html:not(.js)) .photo :global(img) { opacity: 1; }

  .photo--parallax :global(img) {
    height: 118%;
    transform: translate3d(0, var(--shift, 0px), 0);
    will-change: transform;
  }

  .photo__caption {
    position: absolute;
    inset-inline: 0;
    inset-block-end: 0;
    padding: 2.5rem 0.9rem 0.7rem;
    font-family: var(--font-mono);
    font-size: 0.68rem;
    letter-spacing: 0.02em;
    color: var(--paper-0);
    background: linear-gradient(to top, rgb(10 8 7 / 0.72), transparent);
    pointer-events: none;
  }

  /* ---- Без фотографии ----------------------------------------------------
     Место занимает рисунок, а не серая заглушка: <Drawing> рисует то, что
     здесь будет снято. Рамка кадра остаётся — она держит композицию.      */
  .photo--empty {
    border: 1px solid var(--line);
    background: var(--paper-raised);
  }
  .photo--rounded.photo--empty { border-radius: var(--r-lg); }

  :global(.section--ink) .photo--empty {
    background: color-mix(in srgb, var(--ink-invert) 5%, transparent);
    border-color: color-mix(in srgb, var(--ink-invert) 14%, transparent);
  }

  @media (prefers-reduced-motion: reduce) {
    .photo :global(img) { transition: none; opacity: 1; }
    .photo--parallax :global(img) { height: 100%; transform: none; }
  }
</style>
