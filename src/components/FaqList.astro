---
import { isPublic, type FactStatus } from '~/lib/facts';
import UnconfirmedNote from './UnconfirmedNote.astro';

interface Props {
  items: { q: string; a: string; status?: FactStatus }[];
  title?: string;
  lede?: string;
  /** Renders inside a page section with its own heading. */
  standalone?: boolean;
  headingLevel?: 2 | 3;
}

const { items, title = 'Частые вопросы', lede, standalone = true, headingLevel = 2 } = Astro.props;
const visible = items.filter((i) => isPublic(i.status));
const H = `h${headingLevel}` as 'h2' | 'h3';
---

{
  visible.length > 0 && (
    <div class:list={['faq', standalone && 'faq--section']}>
      <div class:list={[standalone && 'container']}>
        {standalone && (
          <div class="section-head">
            <p class="eyebrow">Вопросы</p>
            <H>{title}</H>
            {lede && <p class="lede">{lede}</p>}
          </div>
        )}

        <ul class="faq__list">
          {visible.map((i) => (
            <li>
              <details class="faq__item">
                <summary>
                  <span>{i.q}</span>
                  <svg viewBox="0 0 16 16" aria-hidden="true" class="faq__chev">
                    <path d="M3 6l5 5 5-5" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" />
                  </svg>
                </summary>
                <div class="faq__answer">
                  <p>{i.a}</p>
                  <UnconfirmedNote status={i.status} />
                </div>
              </details>
            </li>
          ))}
        </ul>
      </div>
    </div>
  )
}

<style>
  .faq--section { padding-block: var(--section-y); }

  .faq__list {
    list-style: none;
    margin: 0;
    padding: 0;
    border-block-start: 1px solid var(--line);
    max-width: 52rem;
  }

  .faq__item {
    border-block-end: 1px solid var(--line);
  }

  .faq__item summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--sp-4);
    padding-block: var(--sp-4);
    cursor: pointer;
    list-style: none;
    font-family: var(--font-display);
    font-size: var(--step-1);
    font-weight: 600;
    letter-spacing: var(--tracking-heading);
    line-height: 1.3;
    transition: color var(--dur-1) var(--ease);
  }
  .faq__item summary::-webkit-details-marker { display: none; }
  .faq__item summary:hover { color: var(--accent-ink); }

  .faq__chev {
    width: 1rem;
    flex: none;
    color: var(--ink-3);
    transition: transform var(--dur-2) var(--ease);
  }
  .faq__item[open] .faq__chev { transform: rotate(180deg); }

  .faq__answer {
    padding-block-end: var(--sp-5);
    max-width: 60ch;
    color: var(--ink-2);
    line-height: 1.6;
  }
  .faq__answer p { font-size: var(--step-0); }
</style>
